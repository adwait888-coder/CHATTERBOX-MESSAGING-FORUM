pipeline {
    agent any
    stages {
        stage('Checkout'){
            steps{
                git url: 'https://github.com/adwait888-coder/CHATTERBOX-MESSAGING-FORUM', branch: 'main'
            }
        }
        stage('Build with Maven'){
            steps{
                sh '''
                    mkdir -p target/classes
                    chmod -R 777 target || true

                    docker run --rm \
                    -v ${WORKSPACE}:/app \
                    -w /app \
                    registry.access.redhat.com/ubi8/openjdk-8 \
                    mvn package
                '''
            }
        }
        stage('Deploy with Docker Compose') {
            steps {
                script {
                   
                    sh 'docker compose down || true'

                    
                    sh 'docker compose up -d --build'

                    
                    sh 'docker ps -a'
                }
            }
        }
         stage('Wait and Import Database') {
    steps {
        sh '''
            echo "Waiting for MySQL to boot up..."
            sleep 50

            echo "Importing chatterbox_db.sql into MySQL..."
            docker exec -i chatterbox-mysql mysql -h 127.0.0.1 -u root -p'mysql' chatterbox_db < target/ChatterBox/chatterbox_db.sql

            echo "Database imported successfully!"
        '''
    }
}

    }
}