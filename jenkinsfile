pipeline {
    agent any
    stages {
        stage('Checkout'){
            steps{
                git url: 'https://github.com/adwait888-coder/CHATTERBOX-MESSAGING-FORUM', branch: 'main'
            }
        }
        stage('Build with Maven'){
            steps{
                sh '''
                    mkdir -p target/classes
                    chmod -R 777 target || true

                    docker run --rm \
                    -v ${WORKSPACE}:/app \
                    -w /app \
                    registry.access.redhat.com/ubi8/openjdk-8 \
                    mvn package
                '''
            }
        }
        stage('Deploy with Docker Compose') {
            steps {
                script {
                   
                    sh 'docker compose down || true'

                    
                    sh 'docker compose up -d --build'

                    
                    sh 'docker ps -a'
                }
            }
        }
    }
}